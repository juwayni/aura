func main() int {
    let scores = make(map[string]int)
    scores["alice"] = 100
    scores["bob"] = 85
    scores["charlie"] = 92

    print(len(scores))          // 3
    print(scores["alice"])      // 100
    print(scores["bob"])        // 85

    if "charlie" in scores {
        print("charlie is present")
    }

    scores["bob"] = 99
    print(scores["bob"])        // 99

    let id_map = make(map[int]string)
    id_map[1] = "system"
    id_map[2] = "daemon"
    print(id_map[1])            // system
    return 0
}
