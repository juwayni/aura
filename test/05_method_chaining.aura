struct Vector {
    x int
    y int
}

func (v Vector) add(other Vector) Vector {
    return Vector{ x: v.x + other.x, y: v.y + other.y }
}

func (v Vector) scale(k int) Vector {
    return Vector{ x: v.x * k, y: v.y * k }
}

func (v *Vector) double_in_place() int {
    v.x = v.x * 2
    v.y = v.y * 2
    return 0
}

func main() int {
    let v1 = Vector{ x: 1, y: 2 }
    let v2 = Vector{ x: 3, y: 4 }

    // Method chaining on arbitrary expression returns!
    let v3 = v1.add(v2).scale(10)
    print(v3.x)                // 40
    print(v3.y)                // 60

    // Auto-referencing for pointer receiver
    v3.double_in_place()
    print(v3.x)                // 80
    print(v3.y)                // 120
    return 0
}
