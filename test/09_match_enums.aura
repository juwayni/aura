enum Status {
    Pending
    Running
    Success
    Failed
}

enum Shape {
    Circle(float)
    Rect(float, float)
}

func print_shape(s Shape) int {
    match s {
        case Shape.Circle(r) => {
            print("circle radius:")
            print(r)
        }
        case Shape.Rect(w, h) => {
            print("rect area:")
            print(w * h)
        }
    }
    return 0
}

func print_status(st Status) int {
    match st {
        case Status.Pending => {
            print("pending")
        }
        case Status.Running => {
            print("running")
        }
        case _ => {
            print("other status")
        }
    }
    return 0
}

func main() int {
    let c = Shape.Circle(5.0)
    let r = Shape.Rect(4.0, 6.0)

    print_shape(c)
    print_shape(r)

    print_status(Status.Pending)
    print_status(Status.Running)
    print_status(Status.Success)

    return 0
}
